<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conditional Access Builder v1.0.0" Width="1390" Height="920"
        MinWidth="1090" MinHeight="740" WindowStartupLocation="CenterScreen"
        Background="#F3F6FB" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#14243E"/>
        <SolidColorBrush x:Key="Blue" Color="#2463CA"/>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,9,0"/>
            <Setter Property="Background" Value="#2463CA"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#2463CA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="BorderBrush" Value="#CED8E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#CED8E5"/>
        </Style>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#234466"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DFE6F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="17"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF1F7"/>
            <Setter Property="AlternatingRowBackground" Value="#F7F9FD"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="RowHeight" Value="33"/>
        </Style>
    </Window.Resources>
    <Grid Margin="23,18,23,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,17">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Conditional Access Builder" Foreground="{StaticResource Ink}" FontWeight="Bold" FontSize="26" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#E8EFFA" CornerRadius="12" Padding="12,6"><TextBlock Text="v1.0.0" Foreground="#355580" FontWeight="SemiBold"/></Border>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,11">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,15,0" VerticalAlignment="Center">
                    <TextBlock Text="CONNECTED TENANT" FontWeight="Bold" FontSize="10" Foreground="#6D829E"/>
                    <TextBlock x:Name="TenantText" Text="Not connected" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="DETECTED LICENSING PLAN" FontWeight="Bold" FontSize="10" Foreground="#6D829E"/>
                    <TextBlock x:Name="TierText" Text="Not assessed" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,7,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Emergency access exclusions" FontWeight="Bold" FontSize="15" Foreground="{StaticResource Ink}"/>
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="15"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Emergency account 1  ·  UPN" Foreground="#4D6685" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="Emergency1" Height="32" ToolTip="Resolved to an immutable Entra object ID; must be enabled and cloud-only."/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Emergency account 2  ·  UPN" Foreground="#4D6685" FontSize="11" Margin="0,0,0,4"/>
                        <TextBox x:Name="Emergency2" Height="32" ToolTip="Second emergency identity, independently resolved and excluded."/>
                    </StackPanel>
                </Grid>
                <WrapPanel Margin="0,11,0,0">
                    <CheckBox x:Name="OneEmergencyAccount" Content="Use one emergency account" Margin="0,0,22,0" Foreground="#355778"/>
                    <CheckBox x:Name="NoEmergencyAccounts" Content="No Emergency accounts exist" Margin="0,0,22,0" Foreground="#97501C"/>
                    <CheckBox x:Name="ExcludeOperator" Content="Exclude my signed-in account" Foreground="#355778"/>
                </WrapPanel>
            </StackPanel>
        </Border>
        <WrapPanel Grid.Row="3" Margin="0,1,0,12" VerticalAlignment="Center">
            <Button x:Name="ConnectButton" Content="Connect"/>
            <Button x:Name="SignOutButton" Content="Sign Out"/>
            <Button x:Name="RefreshButton" Content="Refresh Data"/>
            <Button x:Name="PreviewButton" Content="Preview Run"/>
            <Button x:Name="DeployButton" Content="Deploy"/>
        </WrapPanel>
        <TabControl Grid.Row="4" x:Name="MainTabs" Background="White" BorderBrush="#DFE6F0">
            <TabItem Header="Policies">
                <Grid Margin="13">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Select policies to create in report-only mode. Review status and any issues before deployment." Foreground="#526C8A" Margin="2,4,0,8"/>
                    <TextBlock x:Name="PolicySummaryText" Grid.Row="1" Text="Choose policies, then click Preview Run to validate them." Foreground="#355778" FontWeight="SemiBold" Margin="2,0,0,12"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,0,0,10">
                        <Button x:Name="SelectAllButton" Content="Select All" MinHeight="30" Padding="12,4"/>
                        <Button x:Name="DeselectAllButton" Content="Deselect All" MinHeight="30" Padding="12,4"/>
                    </StackPanel>
                    <DataGrid x:Name="Stage1Grid" Grid.Row="3" SelectionMode="Single" IsReadOnly="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="SELECT" Width="68">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanDeploy}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ID" Binding="{Binding Number}" Width="54" IsReadOnly="True"/>
                            <DataGridTextColumn Header="POLICY" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="REQUIRES" Binding="{Binding RequiredLicense}" Width="115" IsReadOnly="True"/>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="DETAILS" Binding="{Binding StatusReason}" Width="2*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Named Locations">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="CA006 • Countries and regions" FontWeight="Bold" FontSize="16" Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="Choose an existing country-based location or define a new one. CA006 must be selected; a named location alone does not create a CA policy." Margin="0,4,0,8" Foreground="#667C97"/>
                        <TextBlock x:Name="CA006SelectionText" Text="CA006 status: not selected" Foreground="#355778" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,10"/>
                        <WrapPanel Margin="0,0,0,6">
                            <RadioButton x:Name="UseExistingLocation" GroupName="LocationMode" IsChecked="True" Content="Use existing" Margin="0,0,18,0"/>
                            <RadioButton x:Name="CreateNewLocation" GroupName="LocationMode" Content="Create from selected countries"/>
                        </WrapPanel>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,5,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="13"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#F7F9FD" BorderBrush="#E4ECF5" BorderThickness="1" CornerRadius="7" Padding="12">
                            <StackPanel>
                                <TextBlock Text="EXISTING TENANT LOCATIONS" FontSize="10" FontWeight="Bold" Foreground="#627F9E"/>
                                <TextBlock Text="Search existing named locations" FontSize="11" Foreground="#627F9E" Margin="0,11,0,4"/>
                                <TextBox x:Name="ExistingLocationSearch" Height="32" ToolTip="Search by name or location ID"/>
                                <ComboBox x:Name="ExistingLocations" Height="34" Margin="0,10,0,8" DisplayMemberPath="Label" SelectedValuePath="Id"/>
                                <TextBlock Text="Refresh tenant to discover available country-based named locations. Select one to use its ID in CA006." Foreground="#657990"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Background="#F7F9FD" BorderBrush="#E4ECF5" BorderThickness="1" CornerRadius="7" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Text="CREATE A COUNTRY-BASED NAMED LOCATION" FontSize="10" FontWeight="Bold" Foreground="#627F9E"/>
                                <Grid Grid.Row="1" Margin="0,9,0,7">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="9"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Location display name (CA006)" FontSize="11" Foreground="#627F9E" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Column="2" Grid.Row="0" Text="Search countries by name / code" FontSize="11" Foreground="#627F9E" Margin="0,0,0,4"/>
                                    <TextBox x:Name="NewLocationName" Grid.Column="0" Grid.Row="1" Height="32" Text="CA006 - Blocked countries" ToolTip="Display name for the country-based named location used by CA006"/>
                                    <TextBox x:Name="CountrySearch" Grid.Column="2" Grid.Row="1" Height="32" ToolTip="Type country name or 2-letter ISO code to filter the list below"/>
                                </Grid>
                                <TextBlock Grid.Row="2" x:Name="SelectedCountriesText" Text="Select countries to block (ISO two-letter country codes)." Margin="0,0,0,8" Foreground="#637991" FontSize="11"/>
                                <DataGrid x:Name="CountryGrid" Grid.Row="3" SelectionMode="Single" IsReadOnly="False" MinHeight="170">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="Use" Binding="{Binding Chosen, UpdateSourceTrigger=PropertyChanged}" Width="54"/>
                                        <DataGridTextColumn Header="COUNTRY OR REGION" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="65" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <CheckBox x:Name="IncludeUnknownCountries" Grid.Row="4" Content="Include unknown/unmapped countries (optional)" Margin="0,10,0,0" Foreground="#496785"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Output">
                <TextBox x:Name="PreviewText" Margin="10" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="NoWrap"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
            </TabItem>
            <TabItem Header="Activity Log">
                <TextBox x:Name="LogText" Margin="10" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <CheckBox x:Name="LicenseAck" Content="I verified that targeted users have the required licensing." VerticalAlignment="Center" Foreground="#425873"/>
        </Grid>
    </Grid>
</Window>
