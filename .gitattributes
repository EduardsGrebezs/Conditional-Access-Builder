# Keep portable source text clean in Git
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.xaml text eol=crlf
*.cmd text eol=crlf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf

# Include only runnable files in GitHub "Code > Download ZIP" archives.
# Keep development sources in Git, but omit them from git-archive output.
.github export-ignore
.github/** export-ignore
Tests export-ignore
Tests/** export-ignore
Tools export-ignore
Tools/** export-ignore
Packaging export-ignore
Packaging/** export-ignore
.gitattributes export-ignore
.gitignore export-ignore
SECURITY.md export-ignore
